# Local development only. Copy to .env and adjust; .env is gitignored.
#
# In production these come from the environment, injected by whatever secret
# management you use — never from a committed file. See DEPLOY.md.

DATABASE_URL=postgresql+psycopg://slottracker:devpassword@127.0.0.1:5432/slottracker
SECRET_KEY=dev-only-not-a-real-secret
APP_URL=http://localhost:8000
TZ=America/Chicago
LOG_LEVEL=debug
RUN_MIGRATIONS_ON_STARTUP=true
